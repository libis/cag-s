{
    "name": "daniel-km/omeka-s-module-analytics-snippet",
    "type": "omeka-s-module",
    "description": "Module for Omeka S: Add a snippet, generally a javascript tracker, in public or admin pages, and allows to track json and xml requests.",
    "keywords": [
        "Omeka S",
        "Omeka S module",
        "seo",
        "tracking",
        "analytics",
        "statistics"
    ],
    "license": "CECILL-2.1",
    "homepage": "https://gitlab.com/Daniel-KM/Omeka-S-module-AnalyticsSnippet",
    "authors": [
        {
            "name": "Daniel Berthereau",
            "email": "Daniel.packagist@Berthereau.net"
        }
    ],
    "support": {
        "issues": "https://gitlab.com/Daniel-KM/Omeka-S-module-AnalyticsSnippet/-/issues",
        "forum": "https://forum.omeka.org/"
    },
    "_require (not set until Omeka S merges PR #2432)": {
        "omeka/omeka-s": "^4.0",
        "daniel-km/omeka-s-module-common": "*"
    },
    "autoload": {
        "psr-4": {
            "AnalyticsSnippet\\": "src/"
        }
    },
    "autoload-dev": {
