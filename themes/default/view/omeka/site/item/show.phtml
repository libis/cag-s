    if (str_contains($referer, $type_array[$type])) {
        $searchReferer = $referer;
    }
}

$thumb = $item->primaryMedia();

$title = $resource->displayTitle();
if ($type === 'Ledenblad') {
    $parts = explode(', ', $title);
    if (count($parts) >= 3) {
        $date = $parts[1];
        [$nr, $name] = array_pad(explode(':', $parts[2], 2), 2, '');

        // If the date falls in the range of a previous title, use that title
        foreach ($item->value('dcterms:replaces', ['all' => true]) as $oldTitle) {
            if (preg_match('#\((.*?)\)#', (string) $oldTitle, $match)) {
                [$from, $to] = array_pad(explode('-', $match[1], 2), 2, null);
                if ($from !== null && $to !== null && $date >= $from && $date <= $to) {
                    $name = (string) $oldTitle;
                }
            }
        }
        $title = trim($name) . ', ' . $date . ', ' . $nr;
    }
}
