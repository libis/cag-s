<?php
$translate = $this->plugin('translate');

if($type != 'Nieuws' && $type != 'Agendapunt'):
  if($type == "Collectie"):
    $provincie = $item->value('dcterms:coverage').'';
    parse_str("property[0][joiner]=and&property[0][property]=14&property[0][type]=eq&property[0][text]=".$provincie."&resource_class_id[]=&resource_template_id[]=7", $query);
  elseif($type == "Beeld"):
    parse_str("property[0][joiner]=and&property[0][property]=3&property[0][type]=eq&property[0][text]=&resource_class_id[]=&resource_template_id[]=6", $query);
    $query['property'][0]['text'] = $item->value('dcterms:subject').'';
  elseif($type == "Film"):
      parse_str("property[0][joiner]=and&property[0][property]=3&property[0][type]=in&property[0][text]=&resource_class_id[]=&resource_template_id[]=10", $query);
      $subject = explode(';',$item->value('dcterms:subject').'');
      $query['property'][0]['text'] = $subject[0];
  elseif($type == "Filmkopie"):
      parse_str("property[0][joiner]=and&property[0][property]=3&property[0][type]=eq&property[0][text]=&resource_class_id[]=&resource_template_id[]=13", $query);
      $query['property'][0]['text'] = $item->value('dcterms:subject').'';
  elseif($type == "Ledenblad"):
      parse_str("resource_template_id[]=37", $query);
   elseif($type == "Kookboek"):
      parse_str("resource_template_id[]=39", $query);    
      //$query['property'][0]['text'] = $item->value('dcterms:subject');
  endif;

  $originalQuery = $query;

  $query['site_id'] = $site->id();
  $query['limit'] = 500;
  $query['sort_by'] = 'created';
  $query['sort_order'] = 'desc';

  $items = $this->api()->search('items',$query);
  $items = $items->getContent();

  //pick random items
  if(sizeof($items) > 1):
    $count = sizeof($items) < 3 ? sizeof($items) : 3;
    $keys = array_rand($items,$count);
    $resources = array();
    foreach($keys as $key):
      $resources[] = $items[$key];
    endforeach;
  //this means that only the current or no item was found
  elseif(sizeof($items) <= 1):
    $resources = array();
  endif;
  ?>
  <?php if($resources):?>
    <div class="section section--default">

      <div class="container">
        <?php if($type == "Collectie"):?>
          <h2>Collecties in de buurt</h2>
