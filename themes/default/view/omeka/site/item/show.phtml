                 <?php
                   $url = str_replace('http:', '', $media->thumbnailUrl('medium'));
                 ?>
                 <div class="card__img card__img_3"
                   style="background:url(<?php echo $url;?>) no-repeat center 20%;background-size: cover;"
                 ></div>
               <?php endif; ?>

