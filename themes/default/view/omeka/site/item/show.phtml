<script>
  $(document).ready(function(){
  if(typeof $.fn.slick != 'undefined'){  
      $('.slider-for').slick({
        slidesToShow: 1,
        slidesToScroll: 1,
        arrows: false,
        fade: true,
        centerMode: true,
        asNavFor: '.slider-nav'
      });
      $('.slider-nav').slick({
        slidesToShow: 10,
        slidesToScroll: 1,
        asNavFor: '.slider-for',
        focusOnSelect: true
      });
      $('.slick-embed').slick({
        slidesToShow: 1,
        slidesToScroll: 1,
        arrows: true,
        fade: true,
        centerMode: true
      });
    }
    $('.beeld').on('contextmenu', 'img', function(e){
      return false;
    });

    $(".copy_button").click(function(e){
        e.preventDefault();
        $(this).next("span").fadeToggle("slow");
        $(this).toggleClass('toggled untoggled');
    });
  });
</script>
